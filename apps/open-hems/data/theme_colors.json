      "tailwind_cost": "text-yellow-500/90",
      "chart_fill": "rgba(234, 179, 8, 0.55)",
      "chart_border": "#EAB308",
      "polarity": "negative",
      "description": "Zonneproductie onder de horizontale as (< 0 kW)"
    },
    "teruglevering": {
      "id": "teruglevering",
